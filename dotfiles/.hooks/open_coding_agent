#!/bin/zsh
set -o errexit
set -o nounset
set -o pipefail

# Queue through the CLI shipped with Desktop. A standalone app-server takes
# the thread's writer lock and lacks Desktop's project/chat tools.
codex_bin="${PR_MONITOR_CODEX_BIN:-/Applications/ChatGPT.app/Contents/Resources/codex-cli/CodexCLI.app/Contents/MacOS/codex}"
open_bin="${PR_MONITOR_OPEN_BIN:-/usr/bin/open}"
if [[ ! -x "$codex_bin" ]]; then
    print -u2 -- "open coding agent: Desktop Codex CLI not found at $codex_bin (override with PR_MONITOR_CODEX_BIN)"
    exit 1
fi

pr_url="${PR_MONITOR_PR_URL:-}"
if [[ ! "$pr_url" =~ '^https://bitbucket\.org/[^/?#]+/[^/?#]+/pull-requests/[0-9]+/?([?#].*)?$' ]]; then
    print -u2 -- "open coding agent: PR_MONITOR_PR_URL must be a Bitbucket Cloud pull request URL"
    exit 1
fi

dispatcher="${PR_MONITOR_CODEX_DISPATCHER:-01a11afd-3f31-7292-bcef-4443c2e6836b}"
prompt='$get-ready '
prompt+="$pr_url"
prompt+=$'\n\nUse the get-ready skill at /Users/robinweston/.agents/skills/get-ready/SKILL.md. First resolve the exact PR head branch and saved parent repository project, inspect live Git worktrees, and search the available Codex chats for one in that project whose actual checkout is on that branch. Match by repository path and live branch state, regardless of chat title; page through chat history when needed. If a suitable chat exists, open that existing chat and return it to the user, preserving any active work. Treat this as a successful handoff and stop. Create a new native worktree chat under the saved parent project only after confirming no suitable existing chat exists and the branch is free. If the branch is occupied without a suitable chat, preserve the checkout and report the blocker. For a new chat, complete get-ready there, report readiness, and wait for input. Keep this dispatcher limited to routing and preparation. Do not start implementation.'

# Do not use queue --resume: that can resume on a separate daemon. Desktop
# must own and run this thread so get-ready has its native chat/worktree tools.
"$codex_bin" queue --thread "$dispatcher" --message "$prompt"
if ! "$open_bin" "codex://threads/$dispatcher"; then
    # The request is already queued. Returning failure could cause a retry to
    # enqueue the same request again.
    print -u2 -- "PR request is queued, but Desktop could not be opened. Open the dispatcher manually: codex://threads/$dispatcher"
fi
print -- "PR request queued to Desktop dispatcher $dispatcher; queue acceptance does not confirm worker setup completion."
