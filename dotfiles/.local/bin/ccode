#!/bin/sh

# Open VS Code with Codex state isolated to the current directory.
# Codex authentication and configuration (including MCP servers) remain shared.
shared_codex_home="${CODEX_SHARED_HOME:-$HOME/.codex}"
workspace_root="$(pwd -P)" || exit 1
vscode_user_data="${CODEX_VSCODE_USER_DATA_DIR:-$HOME/Library/Application Support/Code - Codex}"
shared_vscode_settings="${CODEX_VSCODE_SETTINGS_FILE:-$HOME/.config/Code/User/settings.json}"
vscode_user_dir="$vscode_user_data/User"
vscode_settings="$vscode_user_dir/settings.json"

if ! workspace_hash="$(printf '%s' "$workspace_root" | shasum -a 256 | awk '{print $1}')" ||
    [ "${#workspace_hash}" -ne 64 ]; then
    echo "ccode: unable to hash canonical workspace path: $workspace_root" >&2
    exit 1
fi

vscode_codex_home="$HOME/.cv/$workspace_hash"
workspace_path_file="$vscode_codex_home/workspace-path"
ipc_socket="$vscode_codex_home/ipc/ipc.sock"
ipc_socket_bytes="$(LC_ALL=C printf '%s' "$ipc_socket" | wc -c | tr -d '[:space:]')"

if [ "$ipc_socket_bytes" -ge 104 ]; then
    echo "ccode: Codex IPC socket path is $ipc_socket_bytes bytes (must be below 104): $ipc_socket" >&2
    exit 1
fi

if command -v code >/dev/null 2>&1; then
    code_command="$(command -v code)"
elif [ -x "/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code" ]; then
    code_command="/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code"
else
    echo "ccode: VS Code command not found" >&2
    exit 1
fi

mkdir -p \
    "$vscode_codex_home/rules" \
    "$vscode_codex_home/skills" \
    "$vscode_user_dir" \
    "$shared_codex_home/mcp-oauth-locks" || exit 1

# MCP OAuth credentials in the OS keyring are host-global, so their transaction
# locks must be host-global too. Codex currently resolves these locks below
# CODEX_HOME/mcp-oauth-locks; link only that directory to the shared authority
# while sessions, databases, logs, IPC, and all other runtime state remain in the
# workspace home. Lock files contain no durable state: their ownership is the
# open file descriptor, and files left after a process exits are harmless.
shared_oauth_locks="$shared_codex_home/mcp-oauth-locks"
workspace_oauth_locks="$vscode_codex_home/mcp-oauth-locks"

if [ -L "$workspace_oauth_locks" ]; then
    current_target="$(readlink "$workspace_oauth_locks")"
    if [ "$current_target" != "$shared_oauth_locks" ]; then
        echo "ccode: refusing to replace symlink: $workspace_oauth_locks -> $current_target" >&2
        exit 1
    fi
elif [ -d "$workspace_oauth_locks" ]; then
    # Older ccode versions created workspace-local lock directories. Preserve
    # one recoverable backup instead of deleting their stale lock files. Close
    # existing Codex windows before this migration: advisory locks held by an
    # already-running process remain attached to their original inode.
    legacy_oauth_locks="$vscode_codex_home/mcp-oauth-locks.workspace-backup"
    if [ -e "$legacy_oauth_locks" ] || [ -L "$legacy_oauth_locks" ]; then
        echo "ccode: cannot migrate OAuth locks; backup already exists: $legacy_oauth_locks" >&2
        exit 1
    fi
    mv "$workspace_oauth_locks" "$legacy_oauth_locks" || exit 1
    ln -s "$shared_oauth_locks" "$workspace_oauth_locks" || exit 1
    echo "ccode: moved legacy workspace OAuth locks to: $legacy_oauth_locks" >&2
elif [ -e "$workspace_oauth_locks" ]; then
    echo "ccode: refusing to replace existing path: $workspace_oauth_locks" >&2
    exit 1
else
    ln -s "$shared_oauth_locks" "$workspace_oauth_locks" || exit 1
fi

# --user-data-dir gives Codex windows a separate VS Code User directory. Link
# its settings back to the managed dotfile so regular and Codex windows use the
# same configuration. Replace a stale standalone file left by older versions.
if [ ! -f "$shared_vscode_settings" ]; then
    echo "ccode: shared VS Code settings do not exist: $shared_vscode_settings" >&2
    exit 1
fi

if [ "$vscode_settings" != "$shared_vscode_settings" ]; then
    ln -sfn "$shared_vscode_settings" "$vscode_settings" || exit 1
fi

if [ -e "$workspace_path_file" ]; then
    recorded_workspace="$(cat "$workspace_path_file")" || exit 1
    if [ "$recorded_workspace" != "$workspace_root" ]; then
        echo "ccode: workspace hash collision detected" >&2
        echo "ccode: $vscode_codex_home belongs to: $recorded_workspace" >&2
        echo "ccode: current workspace is: $workspace_root" >&2
        exit 1
    fi
else
    # The digest makes a collision extraordinarily unlikely; this marker lets us
    # detect one rather than silently mixing state from two workspaces.
    printf '%s\n' "$workspace_root" >"$workspace_path_file" || exit 1
fi

link_shared_path() {
    shared_path="$1"
    required="$2"
    source_path="$shared_codex_home/$shared_path"
    target_path="$vscode_codex_home/$shared_path"

    if [ ! -e "$source_path" ]; then
        if [ "$required" = true ]; then
            echo "ccode: shared Codex file does not exist: $source_path" >&2
            return 1
        fi
        return 0
    fi

    if [ -L "$target_path" ]; then
        current_target="$(readlink "$target_path")"
        if [ "$current_target" != "$source_path" ]; then
            echo "ccode: refusing to replace symlink: $target_path -> $current_target" >&2
            return 1
        fi
    elif [ -e "$target_path" ]; then
        echo "ccode: refusing to replace existing file: $target_path" >&2
        return 1
    else
        ln -s "$source_path" "$target_path" || return 1
    fi
}

for shared_path in auth.json config.toml; do
    link_shared_path "$shared_path" true || exit 1
done

for shared_path in rules/default.rules skills/hatch-pet; do
    link_shared_path "$shared_path" false || exit 1
done

# Keep Codex VS Code state separate from regular VS Code while sharing it across
# workspaces. Always pass the workspace root so an argument-free invocation does
# not open the Welcome page.
CODEX_HOME="$vscode_codex_home" exec "$code_command" \
    --user-data-dir "$vscode_user_data" \
    --new-window \
    "$workspace_root" \
    "$@"
